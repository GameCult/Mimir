{
  "bufferSeconds": 5.0,
  "streams": [
    {
      "sourceId": "kiyo-primary",
      "kind": "Video",
      "origin": "LocalDevice",
      "enabled": true,
      "adapter": "native"
    },
    {
      "sourceId": "host-focusrite",
      "kind": "Audio",
      "origin": "LocalDevice",
      "enabled": true,
      "adapter": "native"
    },
    {
      "sourceId": "neighbor-video-srt",
