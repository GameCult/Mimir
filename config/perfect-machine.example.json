{
  "schema": "gamecult.localcast.perfect_machine.v1",
  "reservoir": {
    "durationSeconds": 5.0,
    "clockAuthority": "presentation",
    "lateSamplePolicy": "accept-inside-window",
    "expiredSamplePolicy": "offline-calibration-only",
    "storageLayout": "single-native-rolling-buffer-with-typed-views"
  },
  "viableStreamApp": {
    "owner": "Mimir",
    "solution": "Mimir.slnx",
    "appProject": "src/Mimir.App/Mimir.App.csproj",
    "runtimeProject": "src/Mimir.Runtime/Mimir.Runtime.csproj",
    "windowingRenderingLibrary": "Fensalir",
    "d3d12Bridge": "Fensalir",
    "defaultReservoirSeconds": 5.0,
    "runtimeState": "in-memory-localcast-runtime",
    "syncBuffers": {
      "owner": "Mimir.Runtime",
      "defaultDurationSeconds": 5.0,
      "layout": "one-rolling-buffer-per-configured-audio-or-video-stream",
      "sourceAdapter": "IMimirStreamSource"
    },
    "uiAuthority": "debug-settings-output-management",
    "ingest": {
      "videoFeeds": "local-or-networked-producers",
      "audioFeeds": "local-or-networked-producers",
      "networkFeedsAre": "producers-not-clock-authorities"
    },
    "outputs": {
      "video": "synchronized-program-video",
      "audio": "separately-controllable-synchronized-stems"
    }
  },
  "authorities": {
    "configurationCalibrationLaunchStatus": "Mimir",
    "denseVisualFusion": "Fensalir",
    "gpuMaterialAndBrushReconciliation": "Fensalir",
    "spoutPublication": "Fensalir",
    "hotAudioDsp": "Faust",
    "obsBroadcastControls": "OBS"
  },
  "visualSensors": [
    { "id": "kiyo-primary", "role": "rgb-main", "required": true },
    { "id": "kiyo-secondary", "role": "rgb-stereo", "required": true },
    { "id": "ps3eye-left", "role": "high-rate-feature", "required": true },
    { "id": "ps3eye-right", "role": "high-rate-feature", "required": true },
    { "id": "leap-left-ir", "role": "near-field-timing-depth", "required": true },
    { "id": "leap-right-ir", "role": "near-field-timing-depth", "required": true }
  ],
  "audioSensors": [
    { "id": "host-focusrite", "role": "host-dialogue-anchor", "required": true },
    { "id": "co-streamer-focusrite", "role": "co-streamer-dialogue-anchor", "required": true },
    { "id": "kiyo-0", "role": "camera-spatial-witness", "required": true },
    { "id": "kiyo-1", "role": "camera-spatial-witness", "required": true },
    { "id": "ps-eye-0", "role": "camera-spatial-witness", "required": true },
    { "id": "ps-eye-1", "role": "camera-spatial-witness", "required": true }
  ],
  "reservoirRings": [
    "camera_frame",
    "camera_feature",
    "scene_ray",
    "surface_claim",
    "material_claim",
    "audio_block",
    "phase_claim",
    "event_claim",
    "render_packet"
  ],
  "outputs": {
    "video": {
      "target": "Spout2",
      "senderName": "Mimir Point Cloud",
      "owner": "Fensalir"
    },
    "audio": {
      "owner": "Faust",
      "stems": [
        "host_voice",
        "co_streamer_voice",
        "ambient",
        "transients",
        "local_loopback",
        "co_streamer_loopback",
        "spatial_bed"
      ]
    }
  },
  "runtimePolicy": {
    "liveOnlyIn": [
      "Mimir.Runtime",
      "native-driver-workers",
      "native-reservoir",
      "Fensalir",
      "Faust"
    ],
    "neverInCompatibilityEdges": [
      "dense-feature-extraction",
      "reservoir-reconciliation",
      "hot-dsp",
      "brush-splat-rendering",
      "program-output"
    ]
  }
}
