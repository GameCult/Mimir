{
  "bufferSeconds": 5.0,
  "audioSync": {
    "mode": "chirp-only",
    "referenceSourceId": "asio-ch2",
    "calibrationGain": 2.0,
    "watermarkGain": 0.035,
    "calibrationModelPath": "../calibration/chirp-bin/scarlett-artifact.json",
    "complexContourChannelModelPath": "../calibration/bioacoustic/complex-contour-channel-model.json",
    "bioacousticWitnessProfileId": "canary-packet-trill",
    "enableComplexContourRuntime": true
  },
  "streams": [
    {
      "sourceId": "focusrite-asio",
      "kind": "Audio",
      "origin": "LocalDevice",
      "enabled": true,
      "adapter": "asio",
      "command": "../native/asio_capture/build/Release/mimir_asio_capture.dll",
      "sampleRate": 192000,
      "acceptSourceIds": [
        "asio-ch0",
        "asio-ch1",
        "asio-ch2",
        "asio-ch3"
      ],
      "sourceLabels": {
        "asio-ch0": "Focusrite Input 1",
        "asio-ch1": "Focusrite Input 2",
        "asio-ch2": "Focusrite Loopback 1",
        "asio-ch3": "Focusrite Loopback 2"
      }
    },
    {
      "sourceId": "raven-display",
      "displayName": "Raven screen capture",
      "clockDomainId": "raven-sync",
      "kind": "Video",
      "origin": "Network",
      "enabled": true,
      "adapter": "ffmpeg-rawvideo",
      "command": "ffmpeg",
      "width": 1920,
      "height": 1080,
      "pixelFormat": "Bgra8",
      "arguments": [
        "-hide_banner",
        "-nostdin",
        "-loglevel",
        "warning",
        "-fflags",
        "nobuffer",
        "-flags",
        "low_delay",
        "-i",
        "srt://0.0.0.0:5200?mode=listener&latency=120000&timeout=5000000",
        "-an",
        "-f",
        "rawvideo",
        "-pix_fmt",
        "bgra",
        "-"
      ]
    },
    {
      "sourceId": "eve-camera",
      "displayName": "Eve camera capture",
      "clockDomainId": "eve-camera",
      "kind": "Video",
      "origin": "Network",
      "enabled": true,
      "adapter": "frame-events",
      "command": "../src/Mimir.EveSensorReceiver/bin/Debug/net10.0/Mimir.EveSensorReceiver.exe",
      "arguments": [
        "--port",
        "8793",
        "--path",
        "/eve/camera",
        "--source-id",
        "eve-camera",
        "--type",
        "video-frame"
      ]
    },
    {
      "sourceId": "eve-mic",
      "displayName": "Eve microphone capture",
      "clockDomainId": "eve-camera",
      "kind": "Audio",
      "origin": "Network",
      "enabled": true,
      "adapter": "frame-events",
      "command": "../src/Mimir.EveSensorReceiver/bin/Debug/net10.0/Mimir.EveSensorReceiver.exe",
      "arguments": [
        "--port",
        "8794",
        "--path",
        "/eve/mic",
        "--source-id",
        "eve-mic",
        "--type",
        "audio-block"
      ]
    }
  ]
}
