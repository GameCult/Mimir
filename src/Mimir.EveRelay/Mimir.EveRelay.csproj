<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Mimir.EveRelay</AssemblyName>
    <RootNamespace>Mimir.EveRelay</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Vortice.Direct3D12">
      <HintPath>$(UserProfile)\.nuget\packages\vortice.direct3d12\3.8.3\lib\net10.0\Vortice.Direct3D12.dll</HintPath>
    </Reference>
    <Reference Include="Vortice.DXGI">
      <HintPath>$(UserProfile)\.nuget\packages\vortice.dxgi\3.8.3\lib\net10.0\Vortice.DXGI.dll</HintPath>
    </Reference>
    <Reference Include="Vortice.DirectX">
      <HintPath>$(UserProfile)\.nuget\packages\vortice.directx\3.8.3\lib\net10.0\Vortice.DirectX.dll</HintPath>
    </Reference>
    <Reference Include="Vortice.Mathematics">
      <HintPath>$(UserProfile)\.nuget\packages\vortice.mathematics\2.1.1\lib\net10.0\Vortice.Mathematics.dll</HintPath>
    </Reference>
    <Reference Include="SharpGen.Runtime">
      <HintPath>$(UserProfile)\.nuget\packages\sharpgen.runtime\2.4.2-beta\lib\net9.0\SharpGen.Runtime.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
